{
  "name": "celeste-cr",
  "version": "0.0.0",
  "scripts": {
    "start:celeste": "ng serve celeste-splits --port 4200 -o",
    "start:gamepad": "ng serve gamepad --port 4201 -o",
    "build:celeste": "ng build celeste-splits --configuration production --base-href ./",
    "build:gamepad": "ng build gamepad --configuration production --base-href ./",
    "electron:start:celeste": "electron apps/celeste-splits",
    "electron:start:gamepad": "electron apps/gamepad",
    "electron:dev:celeste": "cross-env ELECTRON_START_URL=http://localhost:4200 electron apps/celeste-splits",
    "electron:dev:gamepad": "cross-env ELECTRON_START_URL=http://localhost:4201 electron apps/gamepad",
    "dist:win:celeste": "npm run build:celeste && electron-builder --config apps/celeste-splits/electron-builder.cjs --win nsis",
    "dist:win:gamepad": "npm run build:gamepad && electron-builder --config apps/gamepad/electron-builder.cjs --win nsis"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "21.2.0",
    "@angular/compiler": "21.2.0",
    "@angular/core": "21.2.0",
    "@angular/forms": "21.2.0",
    "@angular/platform-browser": "21.2.0",
    "@angular/router": "21.2.0",
    "rxjs": "7.8.0",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.11",
    "@angular/cli": "21.2.11",
    "@angular/compiler-cli": "21.2.0",
    "cross-env": "7.0.3",
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "5.9.2",
    "vitest": "4.0.8"
  }
}
